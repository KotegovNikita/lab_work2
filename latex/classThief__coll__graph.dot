digraph "Thief"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="Thief",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="A character card that represents a rogue who can steal cards from the opponent's hand."];
  Node2 -> Node1 [id="edge4_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="Rogue",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classRogue.html",tooltip="A character card with moderate stats, often extended by subclasses like Thief or Assassin."];
  Node3 -> Node2 [id="edge5_Node000002_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="CharacterCard",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classCharacterCard.html",tooltip="Abstract base class for all summonable character cards (e.g., Knight, Mage, Rogue)."];
  Node4 -> Node3 [id="edge6_Node000003_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="Card",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classCard.html",tooltip="Abstract base class representing any playable card in the game."];
}
